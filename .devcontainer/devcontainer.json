{
  "name": "TieOut",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -e '.[dev]' && tieout generate --seed 42 --month 2026-09 --out data/",
  "postAttachCommand": "echo 'Try: tieout reconcile --bank data/bank_statement.csv --gl data/gl_cash.csv   then   tieout serve   (opens the demo on port 8000)'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "TieOut demo", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
