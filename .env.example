# LLM provider: mock (deterministic, no key needed) or gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Stable Gemini Flash model ID per Google's model docs (verified 2026-10). Override as models change.
GEMINI_MODEL=gemini-3.6-flash
# Leave unset to use the model default (recommended for Gemini 3). Range 0 to 2.
# GEMINI_TEMPERATURE=
DATE_WINDOW_DAYS=3
REVIEW_CONFIDENCE_THRESHOLD=0.80
MAX_AGENT_STEPS=6
DB_PATH=tieout.duckdb
